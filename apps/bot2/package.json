{
  "name": "@volvecapital/bot2",
  "main": "dist/bundle/index.js",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "ncc build src/main.ts -o dist/bundle -e @google/genai -e better-sqlite3 -e playwright -e winston -e socket.io-client -e js-toml -e yoctocolors -e winston-daily-rotate-file -e qrcode-terminal -e whatsapp-web.js -e puppeteer",
    "start": "node dist/bundle/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "better-sqlite3": "^12.6.2",
    "js-toml": "^1.0.2",
    "playwright": "^1.58.0",
    "puppeteer": "^25.3.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io-client": "^4.8.3",
    "whatsapp-web.js": "^1.34.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yoctocolors": "^2.1.2"
  }
}